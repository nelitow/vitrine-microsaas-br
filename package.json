{
  "name": "vitrine-microsaas-br",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node --env-file=.env scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "sample": "node scripts/make-sample.mjs && SAMPLE=1 node scripts/build.mjs",
